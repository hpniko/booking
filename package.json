{
  "name": "postre-booking",
  "version": "1.0.0",
  "description": "Postre Live Booking & Rider Dispatch — standalone app (bk_* tables only)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('public','dist/public',{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "tsx -r dotenv/config src/server.ts",
    "typecheck": "tsc --noEmit",
    "gen:vapid": "tsx -r dotenv/config src/services/gen-vapid.ts",
    "verify:boundary": "tsx scripts/verify-boundary.ts",
    "verify:frontend": "node scripts/verify-frontend.cjs",
    "verify:encoding": "node scripts/verify-encoding.cjs",
    "verify:audit": "tsx -r dotenv/config scripts/audit-e2e.ts",
    "verify": "npm run verify:boundary && npm run verify:frontend && npm run verify:encoding && npm run verify:audit",
    "docker:build": "docker build -t postre-booking:latest .",
    "docker:run": "docker run --rm -p 3100:3100 --env-file .env postre-booking:latest",
    "docker:push": "node scripts/docker-push.cjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
