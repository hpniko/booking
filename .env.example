# Shared with Messenger-bot (database only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# For Render: paste the SAME Postgres connection string you use locally.
# Render injects PORT automatically — never set it here.
DATABASE_URL=

# Private to the booking app
PORT=3100
BK_JWT_SECRET=                                # 32+ random chars, required to boot
BK_ADMIN_USERNAME=manager
BK_ADMIN_PASSWORD=                            # change immediately after first login
                                            #   generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Own VAPID pair (npm run gen:vapid)
BK_VAPID_PUBLIC_KEY=
BK_VAPID_PRIVATE_KEY=
BK_VAPID_SUBJECT=mailto:

# ── Render ──────────────────────────────────────────────────────────────────
# Never commit a real .env. On Render set these in the dashboard, not here:
#   DATABASE_URL, BK_JWT_SECRET, BK_ADMIN_USERNAME, BK_ADMIN_PASSWORD,
#   BK_VAPID_PUBLIC_KEY, BK_VAPID_PRIVATE_KEY, BK_VAPID_SUBJECT
# Everything else (commission rate, timezone, cutoff hour, concurrency) is a
# bk_settings row you edit in-app under Settings — not an env var.
# See render.yaml and DEPLOY.md.
NODE_VERSION=22
